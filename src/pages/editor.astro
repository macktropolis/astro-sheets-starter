---
import '../styles/global.css';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Markdown Editor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; }

    body {
      background: var(--color-ink);
      color: var(--color-cream);
      font-family: var(--font-body);
      display: flex;
      flex-direction: column;
    }

    /* ── Toolbar ─────────────────────────────────────────────────── */
    #toolbar {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 1rem;
      background: oklch(0.18 0.045 251);
      border-bottom: 1px solid oklch(0.28 0.05 251);
      flex-shrink: 0;
      flex-wrap: wrap;
    }
    .toolbar-brand {
      font-family: 'Inter', sans-serif;
      font-size: 1.1rem;
      color: var(--color-accent);
      letter-spacing: 0.05em;
      margin-right: 0.25rem;
    }
    .toolbar-sep {
      width: 1px;
      height: 1.4rem;
      background: oklch(0.38 0.05 251);
      margin: 0 0.125rem;
    }
    .tb {
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      border: 1px solid oklch(0.34 0.05 251);
      background: transparent;
      color: oklch(0.85 0.02 251);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      cursor: pointer;
      transition: all 0.12s;
      white-space: nowrap;
      line-height: 1.6;
    }
    .tb:hover {
      background: oklch(0.28 0.05 251);
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
    .tb.component {
      border-color: oklch(0.6566 0.1951 34.49 / 0.6);
      color: var(--color-accent);
    }
    .tb.component:hover { background: oklch(0.6566 0.1951 34.49 / 0.15); }

    .toolbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .session-note {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: oklch(0.5 0.04 251);
      letter-spacing: 0.04em;
    }
    .btn-copy {
      padding: 0.2rem 0.7rem;
      border-radius: 4px;
      border: 1px solid oklch(0.34 0.05 251);
      background: transparent;
      color: oklch(0.7 0.03 251);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      cursor: pointer;
      transition: all 0.12s;
    }
    .btn-copy:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .btn-copy.copied { color: oklch(0.7 0.18 145); border-color: oklch(0.7 0.18 145); }

    /* ── Split pane ──────────────────────────────────────────────── */
    #main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      flex: 1;
      overflow: hidden;
    }
    #editor-pane {
      border-right: 1px solid oklch(0.28 0.05 251);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .pane-label {
      padding: 0.3rem 1rem;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: oklch(0.5 0.04 251);
      background: oklch(0.2 0.042 251);
      border-bottom: 1px solid oklch(0.28 0.05 251);
      flex-shrink: 0;
    }
    #textarea {
      flex: 1;
      resize: none;
      border: none;
      outline: none;
      background: oklch(0.185 0.044 251);
      color: var(--color-cream);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      line-height: 1.75;
      padding: 1.25rem 1.5rem;
      overflow-y: auto;
      tab-size: 2;
    }
    #textarea::placeholder { color: oklch(0.4 0.04 251); }

    #preview-pane {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: var(--color-bg);
    }
    #preview {
      flex: 1;
      overflow-y: auto;
      padding: 2.5rem 2rem;
      color: var(--color-text);
    }

    /* ── Modals ──────────────────────────────────────────────────── */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: oklch(0.05 0.01 240 / 0.82);
      backdrop-filter: blur(5px);
      z-index: 200;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: var(--color-surface);
      border: 1px solid oklch(0.6566 0.1951 34.49 / 0.4);
      border-radius: 0.75rem;
      padding: 1.5rem;
      width: min(90vw, 26rem);
      color: var(--color-text);
    }
    .modal-title {
      font-family: 'Inter', sans-serif;
      font-size: 1.5rem;
      color: var(--color-text);
      margin-bottom: 1rem;
    }
    .field { margin-bottom: 0.75rem; }
    .field label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-muted);
      opacity: 0.7;
      margin-bottom: 0.3rem;
    }
    .field input, .field select {
      width: 100%;
      padding: 0.4rem 0.6rem;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      outline: none;
    }
    .field input:focus, .field select:focus {
      border-color: var(--color-accent);
    }
    .rating-picker { display: flex; gap: 0.4rem; }
    .rating-btn {
      flex: 1;
      padding: 0.35rem 0;
      border-radius: 4px;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.12s;
      text-align: center;
    }
    .rating-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .rating-btn.selected { background: var(--color-accent); border-color: var(--color-accent); color: white; }
    .modal-actions {
      display: flex;
      gap: 0.5rem;
      justify-content: flex-end;
      margin-top: 1.25rem;
    }
    .btn-cancel {
      padding: 0.35rem 1rem;
      border-radius: 4px;
      border: 1px solid var(--color-border);
      background: transparent;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      cursor: pointer;
    }
    .btn-insert {
      padding: 0.35rem 1.1rem;
      border-radius: 4px;
      border: none;
      background: var(--color-accent);
      color: white;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      cursor: pointer;
    }
    .btn-insert:hover { opacity: 0.88; }
  </style>
</head>
<body>

  <!-- Toolbar -->
  <div id="toolbar">
    <span class="toolbar-brand">Markdown Editor</span>
    <div class="toolbar-sep"></div>

    <button class="tb" data-action="bold" title="Cmd+B"><strong>B</strong></button>
    <button class="tb" data-action="italic" title="Cmd+I"><em>I</em></button>

    <div class="toolbar-sep"></div>

    <button class="tb" data-action="h1">H1</button>
    <button class="tb" data-action="h2">H2</button>
    <button class="tb" data-action="h3">H3</button>

    <div class="toolbar-sep"></div>

    <button class="tb" data-action="blockquote" title="Blockquote">&ldquo;</button>
    <button class="tb" data-action="code" title="Code block">{ }</button>
    <button class="tb" data-action="hr" title="Divider">&mdash;</button>
    <button class="tb" data-action="link" title="Link">Link</button>

    <div class="toolbar-sep"></div>

    <button class="tb component" data-action="rating">⭐ Rating Heading</button>
    <button class="tb component" data-action="floatimage">🖼 Float Image</button>

    <div class="toolbar-right">
      <span class="session-note">Session only — content is not saved</span>
      <button class="btn-copy" id="copy-btn">Copy Markdown</button>
    </div>
  </div>

  <!-- Split pane -->
  <div id="main">
    <div id="editor-pane">
      <div class="pane-label">Markdown</div>
      <textarea id="textarea" spellcheck="true" placeholder="Start writing...&#10;&#10;Use the toolbar to insert Rating Heading and Float Image components."></textarea>
    </div>
    <div id="preview-pane">
      <div class="pane-label">Preview</div>
      <div id="preview" class="prose prose-lg max-w-none"></div>
    </div>
  </div>

  <!-- Rating Heading modal -->
  <div class="modal-overlay" id="rating-modal">
    <div class="modal-box">
      <div class="modal-title">Insert Rating Heading</div>
      <div class="field">
        <label>Rating (1–5)</label>
        <div class="rating-picker" id="rating-picker">
          <button class="rating-btn" data-rating="1">1</button>
          <button class="rating-btn" data-rating="2">2</button>
          <button class="rating-btn selected" data-rating="3">3</button>
          <button class="rating-btn" data-rating="4">4</button>
          <button class="rating-btn" data-rating="5">5</button>
        </div>
      </div>
      <div class="field">
        <label>Label</label>
        <input type="text" id="rating-label" list="rating-suggestions" placeholder="e.g. Must Read" />
        <datalist id="rating-suggestions">
          <option value="Skip It"></option>
          <option value="Weak"></option>
          <option value="Decent"></option>
          <option value="Good Read"></option>
          <option value="Must Read"></option>
        </datalist>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" id="rating-cancel">Cancel</button>
        <button class="btn-insert" id="rating-insert">Insert</button>
      </div>
    </div>
  </div>

  <!-- Float Image modal -->
  <div class="modal-overlay" id="float-modal">
    <div class="modal-box">
      <div class="modal-title">Insert Float Image</div>
      <div class="field">
        <label>Image filename (from /assets/blog/)</label>
        <input type="text" id="float-src" placeholder="e.g. comic_boxes.png" />
      </div>
      <div class="field">
        <label>Alt text</label>
        <input type="text" id="float-alt" placeholder="Describe the image" />
      </div>
      <div class="field">
        <label>Float side</label>
        <select id="float-side">
          <option value="left">Left</option>
          <option value="right">Right</option>
          <option value="center">Center</option>
        </select>
      </div>
      <div class="field">
        <label>Width</label>
        <input type="text" id="float-width" value="50%" placeholder="e.g. 50% or 260" />
      </div>
      <div class="field">
        <label>Rotation in degrees (optional)</label>
        <input type="text" id="float-rotation" placeholder="e.g. -10 or 5" />
      </div>
      <div class="field">
        <label>Shadow — opacity &amp; distance (optional)</label>
        <input type="text" id="float-shadow" placeholder="e.g. 0.4 12" />
      </div>
      <div class="field">
        <label>Border — width &amp; color (optional)</label>
        <input type="text" id="float-border" placeholder="e.g. 2 white or 2 #e8c87a" />
      </div>
      <div class="field">
        <label>Caption (optional)</label>
        <input type="text" id="float-caption" placeholder="Optional caption text" />
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" id="float-cancel">Cancel</button>
        <button class="btn-insert" id="float-insert">Insert</button>
      </div>
    </div>
  </div>

  <script>
    import { marked } from 'marked';

    const textarea = document.getElementById('textarea') as HTMLTextAreaElement;
    const preview  = document.getElementById('preview') as HTMLDivElement;

    // ── Component renderers — mirrors the articles loader exactly ────
    function renderRatingHeadings(body: string): string {
      return body.replace(
        /<RatingHeading\s+rating=\{(\d)\}\s+label="([^"]+)"\s*\/>/g,
        (_, ratingStr, label) => {
          const rating = parseInt(ratingStr, 10);
          const glasses = Array.from({ length: 5 }, (_, i) => {
            const dim = i >= rating;
            return `<img src="/assets/3d_glasses.png" alt="" aria-hidden="true" style="width:36px;height:auto;display:block;${dim ? 'opacity:0.2;filter:grayscale(1);' : ''}">`;
          }).join('');
          return `<div class="not-prose" style="display:grid;grid-template-columns:auto 1fr;align-items:center;gap:1rem;margin-top:2.5rem;margin-bottom:0.5rem;"><div style="display:flex;align-items:center;gap:4px;">${glasses}</div><h3 style="font-family:'Inter',sans-serif;font-size:2.1rem;font-weight:normal;line-height:1;margin:0;align-self:center;">${label}</h3></div>`;
        }
      );
    }

    function parseAttrs(attrStr: string): Record<string, string> {
      const attrs: Record<string, string> = {};
      const re = /(\w+)="([^"]*)"/g;
      let m: RegExpExecArray | null;
      while ((m = re.exec(attrStr)) !== null) attrs[m[1]] = m[2];
      return attrs;
    }

    function renderImageFloats(body: string): string {
      return body.replace(
        /<(?:ImageFloat|FloatImage|floatimage)\s+([^>]*?)\s*\/?>/gi,
        (_, attrStr) => {
          const attrs = parseAttrs(attrStr);
          if (!attrs.src) return '';
          const src = (attrs.src.startsWith('http') || attrs.src.startsWith('/'))
            ? attrs.src
            : `/assets/blog/${attrs.src.split('/').pop()}`;
          const side = attrs.side === 'right' ? 'right' : attrs.side === 'center' ? 'center' : 'left';
          const isCentered = side === 'center';
          const alt = attrs.alt ?? '';
          const caption = attrs.caption;
          const rawWidth = attrs.width ?? '260';
          const widthVal = /^\d+$/.test(rawWidth) ? `${rawWidth}px` : rawWidth;
          const margin = isCentered ? '1.5rem auto' : side === 'left' ? '0 2rem 1.5rem 0' : '0 0 1.5rem 2rem';
          const shape = attrs.shape ?? 'auto';
          const shapeStyle = !isCentered && shape === 'auto' ? `shape-outside:url('${src}');shape-margin:1rem;` : '';
          const img = `<img src="${src}" alt="${alt}" style="width:100%;border-radius:8px;display:block;">`;
          const cap = caption ? `<figcaption style="font-size:0.75rem;color:var(--color-muted);margin-top:0.5rem;font-family:monospace;">${caption}</figcaption>` : '';
          const rotationStyle = attrs.rotation ? `transform:rotate(${attrs.rotation}deg);` : '';
          let shadowStyle = '';
          if (attrs.shadow) {
            const parts = attrs.shadow.trim().split(/\s+/);
            const opacity = parts[0] ?? '0.4';
            const dist = parseFloat(parts[1] ?? '8');
            shadowStyle = `box-shadow:0 ${dist}px ${dist * 2}px rgba(0,0,0,${opacity});`;
          }
          let borderStyle = '';
          if (attrs.border) {
            const spaceIdx = attrs.border.trim().indexOf(' ');
            const bwRaw = spaceIdx === -1 ? attrs.border.trim() : attrs.border.trim().slice(0, spaceIdx);
            const bColor = spaceIdx === -1 ? 'var(--color-border)' : attrs.border.trim().slice(spaceIdx + 1).trim();
            const bw = /^\d+$/.test(bwRaw) ? `${bwRaw}px` : bwRaw;
            borderStyle = `border:${bw} solid ${bColor};border-radius:10px;overflow:hidden;`;
          }
          const floatStyle = isCentered ? 'float:none;clear:both;display:block;' : `float:${side};clear:${side};`;
          return `<figure class="not-prose article-float" style="${floatStyle}width:${widthVal};margin:${margin};${shapeStyle}${rotationStyle}${shadowStyle}${borderStyle}">${img}${cap}</figure>`;
        }
      );
    }

    // ── Live preview ─────────────────────────────────────────────────
    async function updatePreview() {
      const transformed = renderRatingHeadings(renderImageFloats(textarea.value));
      preview.innerHTML = String(await Promise.resolve(marked(transformed)));
    }

    // Session persistence — survives refresh, clears on tab close
    const SESSION_KEY = 'retrocult-editor-draft';
    const saved = sessionStorage.getItem(SESSION_KEY);
    if (saved) textarea.value = saved;
    updatePreview();

    textarea.addEventListener('input', () => {
      sessionStorage.setItem(SESSION_KEY, textarea.value);
      updatePreview();
    });

    // ── Helpers ──────────────────────────────────────────────────────
    function insertAtCursor(before: string, after = '', placeholder = '') {
      const start = textarea.selectionStart;
      const end   = textarea.selectionEnd;
      const sel   = textarea.value.substring(start, end) || placeholder;
      textarea.value = textarea.value.substring(0, start) + before + sel + after + textarea.value.substring(end);
      const cur = start + before.length + sel.length;
      textarea.selectionStart = textarea.selectionEnd = cur;
      textarea.focus();
      textarea.dispatchEvent(new Event('input'));
    }

    function prefixLine(prefix: string) {
      const start = textarea.selectionStart;
      const lineStart = textarea.value.lastIndexOf('\n', start - 1) + 1;
      const lineEnd = textarea.value.indexOf('\n', start);
      const end = lineEnd === -1 ? textarea.value.length : lineEnd;
      const line = textarea.value.substring(lineStart, end);
      if (line.startsWith(prefix)) {
        textarea.value = textarea.value.substring(0, lineStart) + line.slice(prefix.length) + textarea.value.substring(end);
      } else {
        textarea.value = textarea.value.substring(0, lineStart) + prefix + line + textarea.value.substring(end);
      }
      textarea.focus();
      textarea.dispatchEvent(new Event('input'));
    }

    // ── Toolbar ──────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.tb[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        switch (btn.dataset.action) {
          case 'bold':       insertAtCursor('**', '**', 'bold text'); break;
          case 'italic':     insertAtCursor('*', '*', 'italic text'); break;
          case 'h1':         prefixLine('# '); break;
          case 'h2':         prefixLine('## '); break;
          case 'h3':         prefixLine('### '); break;
          case 'blockquote': prefixLine('> '); break;
          case 'code':       insertAtCursor('\n```\n', '\n```\n', 'code here'); break;
          case 'hr':         insertAtCursor('\n\n---\n\n'); break;
          case 'link':       insertAtCursor('[', '](https://)', 'link text'); break;
          case 'rating':     openModal('rating-modal'); break;
          case 'floatimage': openModal('float-modal'); break;
        }
      });
    });

    // Keyboard shortcuts
    textarea.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') { e.preventDefault(); insertAtCursor('  '); }
      if ((e.metaKey || e.ctrlKey) && e.key === 'b') { e.preventDefault(); insertAtCursor('**', '**', 'bold text'); }
      if ((e.metaKey || e.ctrlKey) && e.key === 'i') { e.preventDefault(); insertAtCursor('*', '*', 'italic text'); }
    });

    // Copy to clipboard
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(textarea.value);
      copyBtn.textContent = 'Copied!';
      copyBtn.classList.add('copied');
      setTimeout(() => { copyBtn.textContent = 'Copy Markdown'; copyBtn.classList.remove('copied'); }, 2000);
    });

    // ── Modal helpers ────────────────────────────────────────────────
    function openModal(id: string) {
      document.getElementById(id)!.classList.add('open');
      document.querySelector<HTMLInputElement>(`#${id} input, #${id} select`)?.focus();
    }
    function closeModal(id: string) {
      document.getElementById(id)!.classList.remove('open');
      textarea.focus();
    }

    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) (overlay as HTMLElement).classList.remove('open');
      });
    });

    // ── Rating Heading modal ─────────────────────────────────────────
    let selectedRating = 3;

    document.querySelectorAll<HTMLButtonElement>('.rating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedRating = parseInt(btn.dataset.rating!);
        document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
      });
    });

    document.getElementById('rating-cancel')!.addEventListener('click', () => closeModal('rating-modal'));

    document.getElementById('rating-insert')!.addEventListener('click', () => {
      const label = (document.getElementById('rating-label') as HTMLInputElement).value.trim() || 'Rating';
      insertAtCursor(`\n<RatingHeading rating={${selectedRating}} label="${label}" />\n`);
      (document.getElementById('rating-label') as HTMLInputElement).value = '';
      closeModal('rating-modal');
    });

    // Enter key submits rating modal
    document.getElementById('rating-label')!.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('rating-insert')!.click();
    });

    // ── Float Image modal ────────────────────────────────────────────
    document.getElementById('float-cancel')!.addEventListener('click', () => closeModal('float-modal'));

    document.getElementById('float-insert')!.addEventListener('click', () => {
      const src      = (document.getElementById('float-src') as HTMLInputElement).value.trim();
      const alt      = (document.getElementById('float-alt') as HTMLInputElement).value.trim();
      const side     = (document.getElementById('float-side') as HTMLSelectElement).value;
      const width    = (document.getElementById('float-width') as HTMLInputElement).value.trim() || '50%';
      const rotation = (document.getElementById('float-rotation') as HTMLInputElement).value.trim();
      const shadow   = (document.getElementById('float-shadow') as HTMLInputElement).value.trim();
      const border   = (document.getElementById('float-border') as HTMLInputElement).value.trim();
      const caption  = (document.getElementById('float-caption') as HTMLInputElement).value.trim();
      if (!src) { (document.getElementById('float-src') as HTMLInputElement).focus(); return; }

      let tag = `<FloatImage src="${src}" alt="${alt}" side="${side}" width="${width}"`;
      if (rotation) tag += ` rotation="${rotation}"`;
      if (shadow)   tag += ` shadow="${shadow}"`;
      if (border)   tag += ` border="${border}"`;
      if (caption)  tag += ` caption="${caption}"`;
      tag += ` />`;
      insertAtCursor('\n' + tag + '\n');

      // Reset fields
      ['float-src', 'float-alt', 'float-rotation', 'float-shadow', 'float-border', 'float-caption'].forEach(id =>
        (document.getElementById(id) as HTMLInputElement).value = ''
      );
      (document.getElementById('float-width') as HTMLInputElement).value = '50%';
      (document.getElementById('float-side') as HTMLSelectElement).value = 'left';
      closeModal('float-modal');
    });
  </script>

</body>
</html>
