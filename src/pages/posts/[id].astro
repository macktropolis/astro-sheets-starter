---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, publishedAt, image, tags } = entry.data;
const { Content } = await render(entry);

const date = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${title} — My Site`} description={description}>
  <article class="px-6 py-16 max-w-2xl mx-auto">

    {image && (
      <div class="rounded-xl overflow-hidden aspect-[16/7] mb-10">
        <img src={image} alt="" class="w-full h-full object-cover" />
      </div>
    )}

    <header class="mb-10">
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] border border-[var(--color-accent)]/20">
              {tag}
            </span>
          ))}
        </div>
      )}
      <h1 class="text-4xl font-bold text-[var(--color-text)] leading-tight mb-3">{title}</h1>
      <time class="text-sm text-[var(--color-muted)]">{date}</time>
    </header>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <div class="mt-12 pt-6 border-t border-[var(--color-border)]">
      <a href="/posts" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">
        ← All posts
      </a>
    </div>

  </article>
</Layout>
